{
  "name": "clawdeck",
  "productName": "Clawdeck",
  "version": "0.4.0",
  "description": "Desktop app for Claude Code on Linux and Windows",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "setup": "npm install && node node_modules/electron/install.js && vite build",
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "shot": "node scripts/shot.mjs",
    "install-desktop": "sh scripts/install-desktop.sh",
    "icons": "node scripts/icons.mjs",
    "app-icon": "node scripts/app-icon.mjs",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "vite build && electron-builder --linux dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "electron-updater": "6.8.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "author": "Orçun Furkan Türkol",
  "repository": "github:orcunturkol/clawdeck",
  "build": {
    "appId": "com.orcunturkol.clawdeck",
    "productName": "Clawdeck",
    "artifactName": "Clawdeck-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "orcunturkol",
      "repo": "clawdeck",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**",
      "!node_modules/node-pty/{deps,src,third_party}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clawdeck"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "overrides": {
    "minimatch@>=9.0.0 <11.0.1": "11.0.1"
  }
}
